# vitest is pinned to a prerelease (4.1.0-beta.1), and
# @cloudflare/vitest-pool-workers declares its peer as vitest@^4.1.0. Under
# semver a prerelease does not satisfy a caret range, so npm's strict peer
# resolution rejects an otherwise correct tree. Drop this once vitest 4.1.0
# ships stable and the pin can move off the beta.
legacy-peer-deps=true
