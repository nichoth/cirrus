{
	"compilerOptions": {
		/* Base options (inlined -- the repo root is now a single package
		   whose tsconfig targets the Workers runtime, so this app no longer
		   extends it). */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2022",
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"declaration": true,
		"declarationMap": true,
		"module": "preserve",
		"noEmit": true,
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom", "dom.iterable"],
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["vite/client"]
	},
	"include": ["src", "vite.config.ts"]
}
