{
	"name": "@nichoth/pds",
	"version": "0.18.0",
	"description": "Cirrus - A single-user AT Protocol PDS on Cloudflare Workers",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"pds": "./dist/cli.js",
		"create-pds": "./dist/create-pds.js"
	},
	"files": [
		"dist",
		"templates"
	],
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"test": "npm run test:unit && npm run test:cli && npm run test:node",
		"test:unit": "vitest run",
		"test:cli": "vitest run --config vitest.config.cli.ts",
		"test:node": "vitest run --config vitest.config.node.ts",
		"test:e2e": "vitest run --config vitest.config.e2e.ts",
		"check": "publint && attw --pack --ignore-rules=cjs-resolves-to-esm",
		"format": "prettier --write .",
		"knip": "knip"
	},
	"dependencies": {
		"@atcute/atproto": "^3.1.10",
		"@atcute/bluesky": "^3.2.14",
		"@atcute/cbor": "^2.2.8",
		"@atcute/cid": "^2.3.0",
		"@atcute/client": "^4.2.0",
		"@atcute/identity": "^1.1.4",
		"@atcute/identity-resolver": "^1.2.2",
		"@atcute/lexicon-resolver": "^0.1.6",
		"@atcute/lexicons": "^1.2.6",
		"@atcute/tid": "^1.1.1",
		"@atproto/crypto": "^0.4.5",
		"@atproto/lex-cbor": "^0.0.3",
		"@atproto/lex-data": "^0.0.3",
		"@atproto/lex-json": "^0.0.11",
		"@atproto/oauth-scopes": "^0.3.2",
		"@atproto/oauth-types": "^0.6.3",
		"@atproto/repo": "^0.8.12",
		"@atproto/syntax": "^0.4.2",
		"@clack/prompts": "^0.11.0",
		"@simplewebauthn/server": "^13.2.2",
		"bcryptjs": "^3.0.3",
		"citty": "^0.1.6",
		"hono": "^4.11.3",
		"jose": "^6.1.3",
		"picocolors": "^1.1.1",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.2",
		"@atproto/api": "^0.18.9",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@cloudflare/vitest-pool-workers": "0.16.9",
		"@cloudflare/workers-types": "^4.20260524.1",
		"@ipld/car": "^5.4.2",
		"@types/node": "^24.10.4",
		"@types/qrcode": "^1.5.6",
		"@types/ws": "^8.18.1",
		"knip": "^5.78.0",
		"prettier": "^3.7.4",
		"publint": "^0.3.16",
		"tsdown": "^0.18.3",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"vitest": "4.1.0-beta.1",
		"wrangler": "4.94.0",
		"ws": "^8.18.3"
	},
	"peerDependencies": {
		"wrangler": "^4.54.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nichoth/cirrus.git"
	},
	"homepage": "https://github.com/nichoth/cirrus",
	"keywords": [
		"atproto",
		"bluesky",
		"pds",
		"cloudflare-workers"
	],
	"author": "Matt Kane",
	"license": "MIT",
	"packageManager": "npm@11.11.1"
}
